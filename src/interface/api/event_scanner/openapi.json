{
  "openapi": "3.1.0",
  "info": {
    "title": "Event Scanner Service",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/events/find": {
      "get": {
        "summary": "Get Event Source Info",
        "operationId": "get_event_source_info_api_v1_events_find_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetEventSourceInfoResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Find Events",
        "operationId": "find_events_api_v1_events_find_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindEventsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FindEventsResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Artist": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "playcount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Playcount"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Artist"
      },
      "Coordinates": {
        "properties": {
          "lat": {
            "type": "number",
            "title": "Lat"
          },
          "lon": {
            "type": "number",
            "title": "Lon"
          }
        },
        "type": "object",
        "required": [
          "lat",
          "lon"
        ],
        "title": "Coordinates"
      },
      "Event": {
        "properties": {
          "artists": {
            "items": {
              "$ref": "#/components/schemas/Artist"
            },
            "type": "array",
            "title": "Artists"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "venue": {
            "$ref": "#/components/schemas/Venue"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "artists",
          "date",
          "venue"
        ],
        "title": "Event"
      },
      "EventSourceOverview": {
        "properties": {
          "event_source_type": {
            "$ref": "#/components/schemas/EventSourceType"
          },
          "genres": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Genres"
          }
        },
        "type": "object",
        "required": [
          "event_source_type",
          "genres"
        ],
        "title": "EventSourceOverview"
      },
      "EventSourceType": {
        "type": "string",
        "enum": [
          "podiuminfo"
        ],
        "title": "EventSourceType"
      },
      "FindEventsRequest": {
        "properties": {
          "podiuminfo_params": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PodiuminfoSearchParams"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "FindEventsRequest"
      },
      "FindEventsResponse": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "events"
        ],
        "title": "FindEventsResponse"
      },
      "GetEventSourceInfoResponse": {
        "properties": {
          "event_source_overviews": {
            "items": {
              "$ref": "#/components/schemas/EventSourceOverview"
            },
            "type": "array",
            "title": "Event Source Overviews"
          }
        },
        "type": "object",
        "required": [
          "event_source_overviews"
        ],
        "title": "GetEventSourceInfoResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "default": "This is a static response indicating the server is responsive."
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "Location": {
        "properties": {
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "country_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country Code"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "city": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "street": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street"
          },
          "street_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Street Number"
          },
          "postal_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Postal Code"
          },
          "coordinates": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Coordinates"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "Location"
      },
      "PodiuminfoSearchParams": {
        "properties": {
          "start_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start Date",
            "default": "2026-05-14"
          },
          "genre": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Genre"
          }
        },
        "type": "object",
        "title": "PodiuminfoSearchParams"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Venue": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "location": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Location"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "title": "Venue"
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
